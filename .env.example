# Copy this file to .env and fill in real values. Never commit .env itself.

# Database — get a free Postgres instance from Supabase, Railway, or Neon
DATABASE_URL=postgresql://user:password@localhost:5432/stormsentinel

# Auth — generate a real random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_REAL_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM — free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email notifications — free tier at https://resend.com, no card required.
# NOTE: the default sandbox sender (onboarding@resend.dev) only delivers to
# the email on your own Resend account. To actually notify real users you
# must verify a domain you own in the Resend dashboard and set
# RESEND_FROM_EMAIL to an address on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=StormSentinel AI

# Periodic recheck — POST /internal/recheck is meant to be called by a free
# external cron (e.g. https://cron-job.org), since Render's own cron/worker
# products aren't in the free tier. Generate a real secret the same way as
# JWT_SECRET_KEY above, and configure your cron job to send it as the
# X-Cron-Secret header.
CRON_SECRET=CHANGE_THIS_TO_A_REAL_RANDOM_SECRET
SIGNIFICANT_CHANGE_THRESHOLD=15

# Used to build the "view full breakdown" link in notification emails.
FRONTEND_URL=http://localhost:3000

# CORS — your frontend's URL(s), comma-separated. Update for production.
CORS_ORIGINS=http://localhost:3000
